# Скопируйте в .env и при необходимости поменяйте значения.

# --- Django ---
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# --- PostgreSQL (используется и docker compose, и Django) ---
POSTGRES_DB=erp
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp
POSTGRES_PORT=5432
DATABASE_URL=postgres://erp:erp@localhost:5432/erp
